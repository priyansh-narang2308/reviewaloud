# Copy to .env.local and fill in. Never commit .env.local.

# GitHub App (Settings → Developer settings → GitHub Apps). See docs/ARCHITECTURE.md#github-app
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=

# Fine-grained PAT: "Public repositories (read-only)", no other permissions.
# Used only for unauthenticated public PR previews.
GITHUB_PUBLIC_READ_TOKEN=

# OpenRouter (https://openrouter.ai/keys). Server-side only. Free ":free" models
# need no credits but are limited to 20 requests/min and 50/day.
OPENROUTER_API_KEY=
# Optional overrides (defaults in lib/env.ts):
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=

# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=

# Public base URL (used for OAuth redirect). http://localhost:3000 in development.
APP_URL=http://localhost:3000

# Optional: comma-separated owner/repo list. Writes to other repos are refused.
WRITE_REPO_ALLOWLIST=

# Optional: max AI calls per session per day (default 40).
AI_DAILY_CALL_CAP=
